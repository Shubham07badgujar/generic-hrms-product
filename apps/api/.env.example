# Copy to .env and fill in. NEVER commit .env — see .gitignore.

# ── Django ───────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Kolkata

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgres://hrms:hrms_dev_pw@127.0.0.1:5432/hrms

# ── Redis / Celery ───────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# ── JWT ──────────────────────────────────────────────────────────
# Defaults to SECRET_KEY when unset. Set separately in production so
# rotating one does not invalidate the other.
JWT_SIGNING_KEY=
# Must be False over plain HTTP or the browser silently drops the cookie.
REFRESH_COOKIE_SECURE=False

# ── SPA origin (CORS) ────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── PII encryption ───────────────────────────────────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# CRITICAL: back this up outside the database. Losing it makes every
# encrypted PAN / Aadhaar / bank account permanently unreadable. There
# is no recovery path.
FIELD_ENCRYPTION_KEY=change-me

# ── Admin bootstrap ──────────────────────────────────────────────
# The bootstrap route exists ONLY while this is set — unset makes the URL a
# genuine 404 rather than a 403, so it cannot be probed. Remove it once the
# Admin account has been created.
ADMIN_BOOTSTRAP_TOKEN=
ADMIN_BOOTSTRAP_ALLOWED_IPS=127.0.0.1

# ── Email ────────────────────────────────────────────────────────
DEFAULT_FROM_EMAIL=HRMS <noreply@localhost>
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
# Seconds one SMTP conversation may take before it is abandoned. Do not unset
# it: with no timeout, a mail server that accepts the connection and then goes
# quiet blocks the sending thread forever.
EMAIL_TIMEOUT=15

# ── Business rules ───────────────────────────────────────────────
# Candidate PII becomes purge-eligible this long after the final hiring
# decision. Purge is anonymisation requiring explicit HR/Admin approval.
CANDIDATE_RETENTION_MONTHS=12

# ── Object storage (production only) ─────────────────────────────
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=

# ── Monitoring (production only) ─────────────────────────────────
SENTRY_DSN=

# ── eSSL eTimeTrackLite biometric attendance ─────────────────────
# OFF by default. The Web API has its OWN user list (separate from the
# eTimeTrackLite website login) — create the API user in the eSSL admin.
# Verify everything with: manage.py essl_check
ESSL_INTEGRATION_ENABLED=false
ESSL_BASE_URL=
ESSL_USERNAME=
ESSL_PASSWORD=
ESSL_TIMEZONE=Asia/Kolkata
ESSL_SYNC_INTERVAL=5
# Report-only switch: attendance is computed and shown either way, but only
# affects paid days once this is true. Flip deliberately, not on deploy.
ATTENDANCE_AFFECTS_PAYROLL=false

# ── App URLs ─────────────────────────────────────────────────────
# Where the SPA lives; used in every email link and the demo seed.
FRONTEND_URL=http://localhost:5173

# ── Organisation display (fallbacks only) ────────────────────────
# The real name, legal name and logo live in the DATABASE
# (Organisation → Settings, served by /org/branding/). This is only
# the fallback before that row exists.
ORG_DISPLAY_NAME=HRMS

# ── HR mailbox (optional; welcome/credential mail) ───────────────
# When set, account-credential emails are sent through this mailbox
# instead of the default connection. The FROM domain should match a
# domain whose SPF/DKIM/DMARC you control, or providers will junk it.
HR_EMAIL_HOST_USER=
HR_EMAIL_HOST_PASSWORD=
HR_FROM_EMAIL=
HR_CONTACT_EMAIL=

# ── Payroll ──────────────────────────────────────────────────────
# Days after generation during which Finance may delete a payslip.
PAYSLIP_DELETE_WINDOW_DAYS=5

# ── Database tuning ──────────────────────────────────────────────
DB_CONN_MAX_AGE=60

# ── Google Workspace integrations (all optional) ─────────────────
# Forms-based application intake and Calendar/Meet interview invites.
# Leave disabled unless you have a Google Cloud project for them.
GOOGLE_FORMS_OAUTH_CLIENT_FILE=
GOOGLE_FORMS_OAUTH_TOKEN_FILE=
GOOGLE_FORMS_CREDENTIALS_FILE=
GOOGLE_FORMS_FOLDER_ID=
GOOGLE_FORMS_SHARE_WITH=
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID=
GOOGLE_MEET_ENABLED=false
